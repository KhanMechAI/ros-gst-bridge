{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "colcon",
			"command": "/usr/bin/colcon",
			"args": [
				"build",
				"--merge-install",
				"--packages-select",
				"gst_bridge"
			],
			"problemMatcher": [
				"$colcon-helper-gcc",
				"$colcon-helper-msbuild",
				"$colcon-helper-msbuild-info"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"label": "colcon: build"
		}
	]
}